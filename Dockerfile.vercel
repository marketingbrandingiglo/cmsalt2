# IGLO CMS sebagai container service Vercel (lihat vercel.json & DEPLOY-VERCEL.md).
# FrankenPHP = PHP 8.4 + Caddy, listen di $PORT dari Vercel. Region sin1 dekat
# database Neon (ap-southeast-1). Filesystem container TIDAK permanen: data di
# Neon (DB_URL), upload di Cloudflare R2 (MEDIA_DISK=r2).
# (Dockerfile biasa tetap dipakai untuk Railway / VPS.)
FROM dunglas/frankenphp:1-php8.4-bookworm AS base

RUN cp "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini" \
    && install-php-extensions pdo_pgsql intl zip bcmath exif opcache

COPY docker/php.ini /usr/local/etc/php/conf.d/zz-iglo-cms.ini

WORKDIR /app

FROM base AS dependencies

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
COPY composer.json composer.lock ./

RUN composer install --no-dev --no-interaction --no-progress --no-scripts --no-autoloader --prefer-dist

FROM base AS runtime

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
COPY --chown=www-data:www-data . /app
COPY --from=dependencies --chown=www-data:www-data /app/vendor /app/vendor
COPY --chown=www-data:www-data docker/Caddyfile.vercel /etc/frankenphp/Caddyfile

# Autoloader + package discovery + aset Filament, lalu precompile view.
# Config TIDAK di-cache: setiap instance harus membaca env runtime Vercel.
RUN composer dump-autoload --optimize --no-dev \
    && mkdir -p storage/framework/cache/data storage/framework/sessions storage/framework/views \
                storage/logs storage/app/public storage/app/private bootstrap/cache resources/views \
    && php artisan view:cache \
    && php artisan filament:optimize \
    && rm /usr/bin/composer \
    && chmod +x docker/vercel-start.sh \
    && setcap CAP_NET_BIND_SERVICE=+eip /usr/local/bin/frankenphp \
    && chown -R www-data:www-data /app /config/caddy /data/caddy

ENV PORT=80 \
    APP_ENV=production \
    APP_DEBUG=false \
    LOG_CHANNEL=stderr

USER www-data

EXPOSE 80

CMD ["docker/vercel-start.sh"]
